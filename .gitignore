# Node
node_modules/
dist/
*.tsbuildinfo

# Vite
.vite/

# Rust / Tauri
src-tauri/target/
# Tauri generates platform/host-specific schema JSON here on every build.
# Regenerated by tauri-build; not portable across machines.
src-tauri/gen/

# PDFium prebuilt binary (fetched by scripts/fetch-pdfium.sh)
src-tauri/resources/pdfium/*
!src-tauri/resources/pdfium/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Test output
coverage/

# Scratch / exploratory / verification PDFs. Its own README always claimed this
# folder was ignored; it wasn't — only untracked, so one `git add -A` would have
# committed tens of MB of scratch. See `Sample PDFs/README.md` for the layout.
Sample PDFs/

# Tauri build artifacts
*.dmg
*.app
*.msi
*.deb
*.AppImage

# Generated Phase 1 acceptance fixtures (rebuild via the script)
tests/fixtures/acceptance/*.pdf

# Python virtualenv for the fixture generator (PEP 668 forces a venv
# on system Python installs; the venv itself is a per-machine artifact).
.venv*/

# Generated: PDF.js worker copied from node_modules by scripts/copy-pdfjs-worker.mjs
public/pdfjs/
