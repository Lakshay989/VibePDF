{
  "name": "vibepdf",
  "private": true,
  "version": "0.0.1",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-worker.mjs",
    "predev": "node scripts/copy-pdfjs-worker.mjs",
    "dev": "tauri dev",
    "prebuild": "node scripts/copy-pdfjs-worker.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit && eslint src --max-warnings=0 && cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "licenses": "node scripts/generate-notices.mjs",
    "pretest": "node scripts/copy-pdfjs-worker.mjs",
    "test": "vitest run",
    "test:rust": "node scripts/cargo-test.mjs",
    "test:pdf": "node scripts/cargo-test.mjs --test render_compare --test render_to_png --test actor_smoke --test encrypted_open",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "fetch-pdfium": "bash scripts/fetch-pdfium.sh",
    "fetch-tessdata": "bash scripts/fetch-tessdata.sh",
    "fetch-tesseract-src": "bash scripts/fetch-tesseract-src.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
